[Unit]
Description=Restore cdev tmux/Claude Code sessions after boot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# cdev is a plain executable at %h/.local/bin/cdev, so this needs no shell
# wrapper, no PATH lookup, and no login shell to source anything from.
# Same entrypoint a human uses (`cdev restore`), just invoked non-interactively
# by its absolute path.
ExecStart=%h/.local/bin/cdev restore
RemainAfterExit=yes

[Install]
WantedBy=default.target
