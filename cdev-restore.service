[Unit]
Description=Restore cdev tmux/Claude Code sessions after boot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# systemd does not read the shell rc file, so cdev has to be sourced before
# it can be called. Same entrypoint a human uses, no separate script.
ExecStart=/bin/bash -c "source %h/.cdev.sh && cdev restore"
RemainAfterExit=yes

[Install]
WantedBy=default.target
