# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Local env / secrets
.env
.env.*

# Runtime state this project writes at install/run time, in case it ever
# ends up inside the repo checkout instead of $HOME
.cdev-sessions
*.log

# Manual worktrees
.claude/worktrees/

# wrangler writes local dev state and an account cache beside the worker.
# The cache carries a Cloudflare account id and the coarse geolocation of
# whoever ran `wrangler dev`, neither of which belongs in the repo.
deploy/cloudflare/.wrangler/
